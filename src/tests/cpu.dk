#{
# CHIP-8 core tests. Programs are assembled at compile time with `expand ch8(...)`.
#}
import core.builtins.*;
import core.containers.*;
import src.chip8.Chip8;
import src.chip8.asm.ch8;
import src.testing.TestCase;
import src.testing.check;
import src.testing.checkEq;

fun steps(c: ref Chip8, n: i64) = {
	var k: i64 = 0;
	while (k < n) {
		c.step();
		k = k + 1;
	}
}

fun testAsmEncoding() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "CLS; ld v3, 0x2A; DRW V1, V2, 15; 1234; DB 0xF0 #90 7");
	checkEq(c.mem[0x200], 0x00, "CLS hi");
	checkEq(c.mem[0x201], 0xE0, "CLS lo");
	checkEq(c.mem[0x202], 0x63, "LD hi");
	checkEq(c.mem[0x203], 0x2A, "LD lo");
	checkEq(c.mem[0x204], 0xD1, "DRW hi");
	checkEq(c.mem[0x205], 0x2F, "DRW lo");
	checkEq(c.mem[0x206], 0x12, "raw hi");
	checkEq(c.mem[0x207], 0x34, "raw lo");
	checkEq(c.mem[0x208], 0xF0, "DB 1");
	checkEq(c.mem[0x209], 0x90, "DB 2");
	checkEq(c.mem[0x20A], 7, "DB 3");
}

fun testAddImmWrapsWithoutFlag() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, 0xFF; ADD V0, 2");
	steps(&c, 2);
	checkEq(c.v[0], 1, "V0");
	checkEq(c.v[0xF], 0, "VF untouched");
}

fun testAddRegCarry() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, 0xFF; LD V1, 2; ADD V0, V1; LD V2, 1; ADD V2, V2");
	steps(&c, 3);
	checkEq(c.v[0], 1, "V0 wraps");
	checkEq(c.v[0xF], 1, "carry");
	steps(&c, 2);
	checkEq(c.v[2], 2, "V2");
	checkEq(c.v[0xF], 0, "no carry");
}

fun testSubAndSubN() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, 5; LD V1, 7; SUB V0, V1; LD V2, 7; LD V3, 5; SUB V2, V3; LD V4, 5; LD V5, 7; SUBN V4, V5");
	steps(&c, 3);
	checkEq(c.v[0], 0xFE, "5 - 7");
	checkEq(c.v[0xF], 0, "borrow -> VF 0");
	steps(&c, 3);
	checkEq(c.v[2], 2, "7 - 5");
	checkEq(c.v[0xF], 1, "no borrow -> VF 1");
	steps(&c, 3);
	checkEq(c.v[4], 2, "SUBN 7 - 5");
	checkEq(c.v[0xF], 1, "SUBN no borrow");
}

fun testShiftsUseVy() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V1, 0x81; SHR V0, V1; SHL V2, V1");
	steps(&c, 2);
	checkEq(c.v[0], 0x40, "SHR result from VY");
	checkEq(c.v[0xF], 1, "SHR shifted-out bit");
	steps(&c, 1);
	checkEq(c.v[2], 0x02, "SHL result from VY");
	checkEq(c.v[0xF], 1, "SHL shifted-out bit");
}

fun testFlagWrittenAfterResult() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD VF, 0xFF; LD V1, 1; ADD VF, V1");
	steps(&c, 3);
	checkEq(c.v[0xF], 1, "VF holds carry, not sum");
}

fun testLogicResetsVf() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD VF, 1; LD V0, 0x0C; LD V1, 0x0A; OR V0, V1");
	steps(&c, 4);
	checkEq(c.v[0], 0x0E, "OR");
	checkEq(c.v[0xF], 0, "VF reset");
}

fun testCallRet() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "CALL 0x206; LD V1, 7; JP 0x204; LD V0, 5; RET");
	steps(&c, 1);
	checkEq(c.pc, 0x206, "pc after CALL");
	checkEq(c.sp, 1, "sp after CALL");
	steps(&c, 4);
	checkEq(c.v[0], 5, "subroutine ran");
	checkEq(c.v[1], 7, "returned");
	checkEq(c.pc, 0x204, "spinning on JP");
	checkEq(c.sp, 0, "stack empty");
}

fun testSkips() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "SE V0, 0; LD V1, 1; SNE V0, 0; LD V2, 2");
	steps(&c, 3);
	checkEq(c.v[1], 0, "SE skipped");
	checkEq(c.v[2], 2, "SNE did not skip");
}

fun testBcdAndMemory() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, 123; LD I, 0x300; LD B, V0; LD V2, [I]; LD I, 0x310; LD [I], V2");
	steps(&c, 3);
	checkEq(c.mem[0x300], 1, "hundreds");
	checkEq(c.mem[0x301], 2, "tens");
	checkEq(c.mem[0x302], 3, "ones");
	steps(&c, 1);
	checkEq(c.v[2], 3, "loaded V2");
	checkEq(c.i, 0x303, "FX65 advances I");
	steps(&c, 2);
	checkEq(c.mem[0x312], 3, "stored V2");
	checkEq(c.i, 0x313, "FX55 advances I");
}

fun testDrawCollisionAndDisplayWait() = {
	var c: Chip8;
	c.reset();
	c.screenDirty = false;
	expand ch8("c", "LD F, V0; DRW V1, V2, 5; DRW V1, V2, 5");
	steps(&c, 1);
	check(not c.screenDirty, "LD F doesn't touch the screen");
	steps(&c, 5);
	check(c.screenDirty, "draw marks screen dirty");
	check(c.pixel(0, 0), "font 0 top-left pixel");
	check(c.pixel(3, 0), "font 0 top-right pixel");
	check(not c.pixel(1, 1), "font 0 hole");
	checkEq(c.v[0xF], 0, "no collision");
	checkEq(c.pc, 0x204, "display wait blocks further steps");
	c.tickTimers();
	steps(&c, 1);
	check(not c.pixel(0, 0), "second draw erased");
	checkEq(c.v[0xF], 1, "collision");
}

fun testDrawClipsAndWrapsStart() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD I, 0x300; LD V1, 62; DRW V1, V0, 1; LD V1, 65; DRW V1, V0, 1");
	c.mem[0x300] = 0xFFu8;
	steps(&c, 3);
	check(c.pixel(62, 0) and c.pixel(63, 0), "drawn up to the edge");
	check(not c.pixel(0, 0), "clipped, not wrapped");
	c.tickTimers();
	steps(&c, 2);
	check(c.pixel(1, 0), "x 65 wraps to 1");
}

fun testTimers() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, 3; LD DT, V0; LD ST, V0; LD V1, DT");
	steps(&c, 3);
	c.tickTimers();
	steps(&c, 1);
	checkEq(c.v[1], 2, "DT decremented");
	checkEq(c.st, 2, "ST decremented");
}

fun testWaitKeyNeedsRelease() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, K");
	steps(&c, 1);
	checkEq(c.pc, 0x200, "waits with no key");
	c.keys[5] = true;
	steps(&c, 1);
	checkEq(c.pc, 0x200, "still waits while held");
	c.keys[5] = false;
	steps(&c, 1);
	checkEq(c.pc, 0x202, "continues on release");
	checkEq(c.v[0], 5, "key stored");
}

fun testSkipKey() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "LD V0, 0xA; SKP V0; LD V1, 1; SKNP V0; LD V2, 1");
	c.keys[0xA] = true;
	steps(&c, 4);
	checkEq(c.v[1], 0, "SKP skipped");
	checkEq(c.v[2], 1, "SKNP didn't skip");
}

fun testUnknownOpcodeHalts() = {
	var c: Chip8;
	c.reset();
	expand ch8("c", "0123");
	steps(&c, 2);
	check(c.halted, "halted");
	checkEq(c.pc, 0x202, "no further steps");
}

fun addCpuTests(tests: ref List[TestCase]) = {
	tests.push(TestCase("asm.encoding", testAsmEncoding));
	tests.push(TestCase("cpu.add_imm_wraps", testAddImmWrapsWithoutFlag));
	tests.push(TestCase("cpu.add_reg_carry", testAddRegCarry));
	tests.push(TestCase("cpu.sub_subn", testSubAndSubN));
	tests.push(TestCase("cpu.shifts_use_vy", testShiftsUseVy));
	tests.push(TestCase("cpu.flag_after_result", testFlagWrittenAfterResult));
	tests.push(TestCase("cpu.logic_resets_vf", testLogicResetsVf));
	tests.push(TestCase("cpu.call_ret", testCallRet));
	tests.push(TestCase("cpu.skips", testSkips));
	tests.push(TestCase("cpu.bcd_memory", testBcdAndMemory));
	tests.push(TestCase("cpu.draw_collision_wait", testDrawCollisionAndDisplayWait));
	tests.push(TestCase("cpu.draw_clip_wrap", testDrawClipsAndWrapsStart));
	tests.push(TestCase("cpu.timers", testTimers));
	tests.push(TestCase("cpu.wait_key_release", testWaitKeyNeedsRelease));
	tests.push(TestCase("cpu.skip_key", testSkipKey));
	tests.push(TestCase("cpu.unknown_halts", testUnknownOpcodeHalts));
}

#{
# Test registry. Add a `fun testSomething() = {...}` and register it in `allTests`.
#}
import core.builtins.*;
import core.containers.*;
import src.testing.TestCase;
import src.testing.check;
import src.testing.checkEq;
import src.testing.checkStr;
import src.strings.*;
import src.utils.argsFromVmCmdline;
import cpu.addCpuTests;
import octo.addOctoTests;
import schip.addSuperChipTests;
import display.addDisplayTests;

fun testU8Wraps() = {
	let max = 255u8;
	checkEq((max + 1u8) as i64, 0, "255u8 + 1u8");
	let zero = 0u8;
	checkEq((zero - 1u8) as i64, 255, "0u8 - 1u8");
}

fun testHex() = {
	checkStr(hex(0).asSlice(), "0x0", "hex(0)");
	checkStr(hex(0x1F2Ai64).asSlice(), "0x1F2A", "hex(0x1F2A)");
}

fun testContains() = {
	check(contains("chip8.cls", "cls"), "suffix");
	check(contains("abc", ""), "empty needle");
	check(not contains("abc", "abcd"), "needle longer");
	check(not contains("abc", "x"), "missing");
}

fun testSplitNul() = {
	var s = "ab".toString();
	s.append('\0');
	s.append("cd");
	s.append('\0');
	var parts = splitNul(&s);
	checkEq(parts.length(), 2, "part count");
	checkStr(parts.at(0).asSlice(), "ab", "first part");
	checkStr(parts.at(1).asSlice(), "cd", "second part");
}

fun testHexPadded() = {
	checkStr(hexPadded(0x2A, 4).asSlice(), "0x002A", "padded to 4");
	checkStr(hexPadded(0x12345, 4).asSlice(), "0x2345", "only the low 4 nibbles");
}

fun testDigitValue() = {
	checkEq(digitValue('7', 10).valueOr(-1), 7, "decimal digit");
	checkEq(digitValue('f', 16).valueOr(-1), 15, "lowercase hex");
	checkEq(digitValue('B', 16).valueOr(-1), 11, "uppercase hex");
	check(digitValue('8', 8).isEmpty(), "8 isn't an octal digit");
	check(digitValue('X', 16).isEmpty(), "not a digit");
}

fun testParseDecimal() = {
	checkEq(parseDecimal("1234").valueOr(-1), 1234, "number");
	check(parseDecimal("").isEmpty(), "empty");
	check(parseDecimal("12a").isEmpty(), "trailing letter");
	check(parseDecimal("-3").isEmpty(), "no sign");
}

fun testAffixes() = {
	check(strEq("abc", "abc"), "equal");
	check(not strEq("abc", "abd"), "differ");
	check(startsWith("OCTO_x", "OCTO_"), "prefix");
	check(endsWith("game.8o", ".8o"), "suffix");
	check(not endsWith("o", ".8o"), "suffix longer than the string");
}

fun testSplitOn() = {
	var parts = splitOn("a,,b", ',');
	checkEq(parts.length(), 3, "piece count");
	checkStr(parts.at(0).asSlice(), "a", "first");
	checkStr(parts.at(1).asSlice(), "", "empty middle");
	checkStr(parts.at(2).asSlice(), "b", "last");
}

fun cmdline(words: str) -> List[String] = splitOn(words, ' ');

fun testArgsFromVmCmdline() = {
	var vm = cmdline("VM run -c game.8o,--dump,30 /b/app.dbc");
	var args = argsFromVmCmdline(&vm);
	checkEq(args.length(), 4, "argv[0] + 3 arguments");
	checkStr(args.at(0).asSlice(), "/b/app.dbc", "argv[0] is the bytecode");
	checkStr(args.at(1).asSlice(), "game.8o", "first argument");
	checkStr(args.at(3).asSlice(), "30", "last argument");

	var bare = cmdline("VM --fast-mode run /b/app.dbc");
	var none_given = argsFromVmCmdline(&bare);
	checkEq(none_given.length(), 1, "no -c: just argv[0]");

	var longForm = cmdline("VM run --args -t,cpu /b/app.dbc");
	var tests = argsFromVmCmdline(&longForm);
	checkEq(tests.length(), 3, "--args works like -c");
	checkStr(tests.at(1).asSlice(), "-t", "option passed through");
}

fun allTests() -> List[TestCase] = {
	var tests: List[TestCase];
	tests.push(TestCase("lang.u8_wraps", testU8Wraps));
	tests.push(TestCase("strings.hex", testHex));
	tests.push(TestCase("strings.hex_padded", testHexPadded));
	tests.push(TestCase("strings.contains", testContains));
	tests.push(TestCase("strings.affixes", testAffixes));
	tests.push(TestCase("strings.digit_value", testDigitValue));
	tests.push(TestCase("strings.parse_decimal", testParseDecimal));
	tests.push(TestCase("strings.split_nul", testSplitNul));
	tests.push(TestCase("strings.split_on", testSplitOn));
	tests.push(TestCase("utils.args_from_vm_cmdline", testArgsFromVmCmdline));
	addCpuTests(&tests);
	addOctoTests(&tests);
	addSuperChipTests(&tests);
	addDisplayTests(&tests);
	return tests;
}

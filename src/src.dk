import core.builtins.*;
import core.containers.*;
import utils.readCmdline;
import utils.readFile;
import testing.runTests;
import strings.*;
import tests.allTests;
import chip8.Chip8;
import chip8.newChip8;
import chip8.RomTooBig;
import chip8.Halted;
import chip8.platform.Platform;
import chip8.platform.cosmacVip;
import chip8.platform.superChip;
import emulator.runInteractive;
import emulator.runHeadless;
import errors.*;
import result.Ok;
import result.Err;
import tui.terminal.TerminalError;
import tui.render.TooSmall;
import chip8.octo.assembleOcto;
import chip8.octo.OctoError;

const USAGE: str = "usage: duckling-hackathon <rom.ch8 | program.8o> [--chip8 | --schip] [--dump <frames>] | -t [filter]";

# ========== COMMAND LINE ===========

#{
# How to run a ROM.
#}
class Options {
	platform: Platform = superChip(); # SUPER-CHIP unless --chip8
	dumpFrames: ?i64 = none; # --dump N: run headless for N frames, print the screen
}

#{
# `-t [filter]`: run the unit tests whose names contain `filter`.
#}
class RunTests {
	filter: ?str;
}

#{
# `<path> [options]`: run a ROM or Octo source.
#}
class RunFile {
	path: str;
	opts: Options;
}

const Command = RunTests | RunFile;

fun parseOptions(args: ref mut List[String]) -> ?Options = {
	var opts = Options(superChip(), none);
	var k: i64 = 2;
	while (k < args.length()) {
		let arg = args.at(k).asSlice();
		if (strEq(arg, "--chip8")) {
			opts.platform = cosmacVip();
		} else if (strEq(arg, "--schip")) {
			opts.platform = superChip();
		} else if (strEq(arg, "--dump") and k + 1 < args.length()) {
			k = k + 1;
			opts.dumpFrames = parseDecimal(args.at(k).asSlice());
			if (opts.dumpFrames.isEmpty()) return none;
		} else {
			return none;
		}
		k = k + 1;
	}
	return opts;
}

#{
# The command `args` (argv[0] first) asks for; none on a usage error.
#}
fun parseArgs(args: ref mut List[String]) -> ?Command = {
	if (args.length() < 2) return none;
	let first = args.at(1).asSlice();
	if (strEq(first, "-t")) {
		if (args.length() == 2) return RunTests(none) as Command;
		if (args.length() == 3) return RunTests(args.at(2).asSlice()) as Command;
		return none;
	}
	let opts = parseOptions(args);
	if (opts.isEmpty()) return none;
	return RunFile(first, opts.value()) as Command;
}

# ========== RUNNING ===========

fun start(chip: ref Chip8, path: str, opts: Options) -> AppResult = {
	if (opts.dumpFrames.nonEmpty()) return runHeadless(chip, opts.dumpFrames.value());
	return runInteractive(chip, path);
}

fun runRom(rom: ref String, path: str, opts: Options) -> AppResult = {
	var chip = newChip8(opts.platform);
	return match (chip.loadRom(rom.asSlice())) {
		case _: Ok[()] = start(&chip, path, opts);
		case e: Err[RomTooBig] = failed(e.error);
	};
}

fun asmFailed(path: str, e: ref OctoError) -> AppResult = failed(AsmFailed(path.toString(), e.line, copy e.message));

#{
# Assembles an Octo source, then runs it.
#}
fun runOcto(source: ref String, path: str, opts: Options) -> AppResult = {
	return match (assembleOcto(source.asSlice())) {
		case rom: Ok[String] = runRom(&rom.value, path, opts);
		case e: Err[OctoError] = asmFailed(path, &e.error);
	};
}

#{
# Runs a `.ch8` ROM, or a `.8o` Octo source after assembling it.
#}
fun runContent(content: ref String, path: str, opts: Options) -> AppResult = {
	if (endsWith(path, ".8o")) return runOcto(content, path, opts);
	return runRom(content, path, opts);
}

fun runFile(path: str, opts: Options) -> AppResult = {
	return match (readFile(path)) {
		case content: String = runContent(&content, path, opts);
		case _ = failed(ReadFailed(path.toString()));
	};
}

# ========== EXIT CODES ===========

fun fail(message: String) -> i64 = {
	print(f"Error: {message}\n");
	return 1;
}

#{
# Prints `error` and returns the process exit code for it.
#}
fun report(error: ref AppError) -> i64 = {
	return match (error) {
		case e: ref ReadFailed = fail(f"could not read {e.path}");
		case e: RomTooBig = fail(f"ROM too big: {e.size} bytes, max {e.max}");
		case e: TerminalError = e.report();
		case e: TooSmall = fail(e.message());
		case e: ref Halted = fail(f"CHIP-8 halted: {e.reason}");
		case e: ref AsmFailed = fail(f"{e.path}:{e.line}: {e.message}");
	};
}

fun exitCode(result: AppResult) -> i64 = {
	return match (&result) {
		case _: ref Ok[()] = 0i64;
		case e: ref Err[AppError] = report(&e.error);
	};
}

fun runTestsMatching(filter: ?str) -> i64 = {
	var tests = allTests();
	return runTests(&tests, filter);
}

fun execute(command: Command) -> i64 = {
	return match (command) {
		case t: RunTests = runTestsMatching(t.filter);
		case r: RunFile = exitCode(runFile(r.path, r.opts));
	};
}

#{
# Returns the exit code instead of calling libc `exit`, which would kill the
# DVM from inside a program it is running.
#}
fun main() -> i64 = {
	var args = readCmdline();
	if (args.isEmpty()) return fail("could not read the command line".toString());
	let command = parseArgs(args.value());
	if (command.isEmpty()) return fail(USAGE.toString());
	return execute(command.value());
}

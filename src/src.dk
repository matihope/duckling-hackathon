import core.builtins.*;
import core.containers.*;
import utils.read_cmdline;
import utils.read_file;
import utils.exit_with_error;
import testing.runTests;
import testing.strEq;
import tests.allTests;
import chip8.Chip8;
import chip8.RomTooBig;
import emulator.runInteractive;
import emulator.runHeadless;
import errors.*;
import result.Ok;
import result.Err;
import tui.terminal.TerminalError;
import tui.render.TooSmall;
import chip8.octo.assembleOcto;
import chip8.octo.OctoError;

const USAGE: str = "usage: duckling-hackathon <rom.ch8 | program.8o> [--chip8 | --schip] [--dump <frames>] | -t [filter]";

# Non-negative decimal from `s`, or -1.
fun parseCount(s: str) -> i64 = {
	if (s.length() == 0) return -1;
	var value: i64 = 0;
	var k: i64 = 0;
	while (k < s.length()) {
		if (s[k] < '0' or s[k] > '9') return -1;
		value = value * 10 + (s[k] - '0') as i64;
		k = k + 1;
	}
	return value;
}

#{
# Command-line options after the ROM path.
#}
class Options {
	dumpFrames: i64 = -1; # --dump N: run headless for N frames, print the screen
	superChip: bool = true; # SUPER-CHIP unless --chip8
}

fun start(chip: ref Chip8, path: str, opts: Options) -> AppResult = {
	if (opts.dumpFrames >= 0) return runHeadless(chip, opts.dumpFrames);
	return runInteractive(chip, path);
}

fun runRom(rom: ref String, path: str, opts: Options) -> AppResult = {
	var chip: Chip8;
	chip.superChip = opts.superChip;
	chip.reset();
	return match (chip.loadRom(rom.asSlice())) {
		case _: Ok[()] = start(&chip, path, opts);
		case e: Err[RomTooBig] = failed(e.error);
	};
}

fun endsWith(s: str, suffix: str) -> bool = {
	if (s.length() < suffix.length()) return false;
	let offset = s.length() - suffix.length();
	var k: i64 = 0;
	while (k < suffix.length()) {
		if (s[offset + k] != suffix[k]) return false;
		k = k + 1;
	}
	return true;
}

fun asmFailed(path: str, e: ref OctoError) -> AppResult = failed(AsmFailed(path.toString(), e.line, copy e.message));

#{
# Assembles an Octo source, then runs it.
#}
fun runOcto(source: ref String, path: str, opts: Options) -> AppResult = {
	return match (assembleOcto(source.asSlice())) {
		case rom: Ok[String] = runRom(&rom.value, path, opts);
		case e: Err[OctoError] = asmFailed(path, &e.error);
	};
}

#{
# Runs a `.ch8` ROM, or a `.8o` Octo source after assembling it.
#}
fun runContent(content: ref String, path: str, opts: Options) -> AppResult = {
	if (endsWith(path, ".8o")) return runOcto(content, path, opts);
	return runRom(content, path, opts);
}

fun runFile(path: str, opts: Options) -> AppResult = {
	return match (read_file(path)) {
		case content: String = runContent(&content, path, opts);
		case _ = failed(ReadFailed(path.toString()));
	};
}

fun fail(message: String) -> i64 = {
	print(f"Error: {message}\n");
	return 1;
}

#{
# Prints `error` and returns the process exit code for it.
#}
fun report(error: ref AppError) -> i64 = {
	return match (error) {
		case e: ref ReadFailed = fail(f"could not read {e.path}");
		case e: RomTooBig = fail(f"ROM too big: {e.size} bytes, max {e.max}");
		case e: TerminalError = e.report();
		case e: TooSmall = fail(e.message());
		case e: ref Halted = fail(f"CHIP-8 halted: {e.reason}");
		case e: ref AsmFailed = fail(f"{e.path}:{e.line}: {e.message}");
	};
}

fun exitCode(result: ref AppResult) -> i64 = {
	return match (result) {
		case _: Ok[()] = 0i64;
		case e: ref Err[AppError] = report(&e.error);
	};
}

fun main() = {
	var args = read_cmdline();
	if (args.isEmpty()) exit_with_error("Could not read /proc/self/cmdline");
	if (args.value().length() < 2i64) exit_with_error(USAGE);

	if (strEq(args.value().at(1i64).asSlice(), "-t")) {
		var tests = allTests();
		if (args.value().length() > 2i64) return runTests(&tests, args.value().at(2i64).asSlice());
		return runTests(&tests, none);
	}

	let path = args.value().at(1i64).asSlice();
	var opts: Options;
	var k: i64 = 2;
	while (k < args.value().length()) {
		let arg = args.value().at(k).asSlice();
		if (strEq(arg, "--chip8")) {
			opts.superChip = false;
			k = k + 1;
		} else if (strEq(arg, "--schip")) {
			opts.superChip = true;
			k = k + 1;
		} else if (strEq(arg, "--dump") and k + 1 < args.value().length()) {
			opts.dumpFrames = parseCount(args.value().at(k + 1).asSlice());
			if (opts.dumpFrames < 0) exit_with_error(USAGE);
			k = k + 2;
		} else {
			exit_with_error(USAGE);
		}
	}

	var result = runFile(path, opts);
	return exitCode(&result);
}

# ========== INSTRUCTIONS ===========
# One class per opcode; `x`/`y` are register indices, `nn` a byte, `nnn` an address.

class Cls {} # 00E0
class Ret {} # 00EE
class Jump {
	nnn: u16;
} # 1NNN
class Call {
	nnn: u16;
} # 2NNN
class SkipEqImm {
	x: i64;
	nn: u8;
} # 3XNN
class SkipNeImm {
	x: i64;
	nn: u8;
} # 4XNN
class SkipEqReg {
	x: i64;
	y: i64;
} # 5XY0
class LoadImm {
	x: i64;
	nn: u8;
} # 6XNN
class AddImm {
	x: i64;
	nn: u8;
} # 7XNN
class Move {
	x: i64;
	y: i64;
} # 8XY0
class Or {
	x: i64;
	y: i64;
} # 8XY1
class And {
	x: i64;
	y: i64;
} # 8XY2
class Xor {
	x: i64;
	y: i64;
} # 8XY3
class AddReg {
	x: i64;
	y: i64;
} # 8XY4
class Sub {
	x: i64;
	y: i64;
} # 8XY5
class ShiftRight {
	x: i64;
	y: i64;
} # 8XY6
class SubN {
	x: i64;
	y: i64;
} # 8XY7
class ShiftLeft {
	x: i64;
	y: i64;
} # 8XYE
class SkipNeReg {
	x: i64;
	y: i64;
} # 9XY0
class LoadI {
	nnn: u16;
} # ANNN
class JumpV0 {
	nnn: u16;
} # BNNN
class Random {
	x: i64;
	nn: u8;
} # CXNN
class Draw {
	x: i64;
	y: i64;
	n: i64;
} # DXYN
class SkipKey {
	x: i64;
} # EX9E
class SkipNotKey {
	x: i64;
} # EXA1
class LoadDelay {
	x: i64;
} # FX07
class WaitKey {
	x: i64;
} # FX0A
class SetDelay {
	x: i64;
} # FX15
class SetSound {
	x: i64;
} # FX18
class AddI {
	x: i64;
} # FX1E
class LoadFont {
	x: i64;
} # FX29
class StoreBcd {
	x: i64;
} # FX33
class StoreRegs {
	x: i64;
} # FX55
class LoadRegs {
	x: i64;
} # FX65
class Unknown {
	op: u16;
}

# SUPER-CHIP
class ScrollDown {
	n: i64;
} # 00CN
class ScrollRight {} # 00FB
class ScrollLeft {} # 00FC
class Exit {} # 00FD
class Lores {} # 00FE
class Hires {} # 00FF
class LoadBigFont {
	x: i64;
} # FX30
class SaveFlags {
	x: i64;
} # FX75
class LoadFlags {
	x: i64;
} # FX85

const Instruction = Cls | Ret | Jump | Call | SkipEqImm | SkipNeImm | SkipEqReg | LoadImm | AddImm
	| Move | Or | And | Xor | AddReg | Sub | ShiftRight | SubN | ShiftLeft | SkipNeReg | LoadI
	| JumpV0 | Random | Draw | SkipKey | SkipNotKey | LoadDelay | WaitKey | SetDelay | SetSound
	| AddI | LoadFont | StoreBcd | StoreRegs | LoadRegs | ScrollDown | ScrollRight | ScrollLeft
	| Exit | Lores | Hires | LoadBigFont | SaveFlags | LoadFlags | Unknown;

#{
# Turns a 16-bit opcode into its `Instruction`.
#}
fun decode(op: u16) -> Instruction = {
	let kind = op >> 12u16;
	let x = ((op >> 8u16) & 0xFu16) as i64;
	let y = ((op >> 4u16) & 0xFu16) as i64;
	let n = (op & 0xFu16) as i64;
	let nn = (op & 0xFFu16) as u8;
	let nnn = op & 0xFFFu16;

	if (op == 0x00E0u16) return Cls();
	if (op == 0x00EEu16) return Ret();
	if ((op & 0xFFF0u16) == 0x00C0u16) return ScrollDown(n);
	if (op == 0x00FBu16) return ScrollRight();
	if (op == 0x00FCu16) return ScrollLeft();
	if (op == 0x00FDu16) return Exit();
	if (op == 0x00FEu16) return Lores();
	if (op == 0x00FFu16) return Hires();
	if (kind == 0x1u16) return Jump(nnn);
	if (kind == 0x2u16) return Call(nnn);
	if (kind == 0x3u16) return SkipEqImm(x, nn);
	if (kind == 0x4u16) return SkipNeImm(x, nn);
	if (kind == 0x5u16 and n == 0) return SkipEqReg(x, y);
	if (kind == 0x6u16) return LoadImm(x, nn);
	if (kind == 0x7u16) return AddImm(x, nn);
	if (kind == 0x8u16) {
		if (n == 0x0) return Move(x, y);
		if (n == 0x1) return Or(x, y);
		if (n == 0x2) return And(x, y);
		if (n == 0x3) return Xor(x, y);
		if (n == 0x4) return AddReg(x, y);
		if (n == 0x5) return Sub(x, y);
		if (n == 0x6) return ShiftRight(x, y);
		if (n == 0x7) return SubN(x, y);
		if (n == 0xE) return ShiftLeft(x, y);
	}
	if (kind == 0x9u16 and n == 0) return SkipNeReg(x, y);
	if (kind == 0xAu16) return LoadI(nnn);
	if (kind == 0xBu16) return JumpV0(nnn);
	if (kind == 0xCu16) return Random(x, nn);
	if (kind == 0xDu16) return Draw(x, y, n);
	if (kind == 0xEu16 and nn == 0x9Eu8) return SkipKey(x);
	if (kind == 0xEu16 and nn == 0xA1u8) return SkipNotKey(x);
	if (kind == 0xFu16) {
		if (nn == 0x07u8) return LoadDelay(x);
		if (nn == 0x0Au8) return WaitKey(x);
		if (nn == 0x15u8) return SetDelay(x);
		if (nn == 0x18u8) return SetSound(x);
		if (nn == 0x1Eu8) return AddI(x);
		if (nn == 0x29u8) return LoadFont(x);
		if (nn == 0x33u8) return StoreBcd(x);
		if (nn == 0x55u8) return StoreRegs(x);
		if (nn == 0x65u8) return LoadRegs(x);
		if (nn == 0x30u8) return LoadBigFont(x);
		if (nn == 0x75u8) return SaveFlags(x);
		if (nn == 0x85u8) return LoadFlags(x);
	}
	return Unknown(op);
}

#{
# The ROM doesn't fit in memory above 0x200.
#}
class RomTooBig {
	size: i64;
	max: i64;
}

# `0x`-prefixed, zero-padded 4-digit uppercase hex.
fun hex4(v: i64) -> String = {
	let digits = "0123456789ABCDEF";
	var out = "0x".toString();
	var shift: i64 = 12;
	while (shift >= 0) {
		out.append(digits[(v >> shift) & 15]);
		shift = shift - 4;
	}
	return out;
}

# Wraps an address into the 4 KiB memory.
fun wrapAddr(a: i64) -> i64 = a & (MEMORY_SIZE - 1);

# ========== MACHINE ===========
class Chip8 {
	mem: u8[4096];
	v: u8[16];
	i: u16 = 0u16;
	pc: u16 = 0x200u16;
	stack: u16[16];
	sp: i64 = 0;
	dt: u8 = 0u8; # delay timer
	st: u8 = 0u8; # sound timer
	superChip: bool = false; # SUPER-CHIP mode; set before `reset()`
	hires: bool = false; # SUPER-CHIP 128x64 mode
	display: bool[8192]; # pixel (x, y) at y * width() + x
	keys: bool[16]; # set by the frontend
	screenDirty: bool = true; # display changed since the frontend last drew it
	waitingForFrame: bool = false; # DXYN ran this frame (display wait quirk)
	heldKey: i64 = -1; # FX0A: key seen pressed, waiting for its release
	halted: bool = false;
	haltReason: String;
	exited: bool = false; # SUPER-CHIP 00FD ran
	flags: u8[16]; # SUPER-CHIP FX75/FX85 registers, kept across `reset()`

	#{
	# Clears the machine and loads the font. Call before `loadRom`.
	#}
	fun reset() = {
		var a: i64 = 0;
		while (a < MEMORY_SIZE) {
			mem[a] = 0u8;
			a = a + 1;
		}
		a = 0;
		while (a < 80) {
			mem[FONT_START + a] = FONT[a];
			a = a + 1;
		}
		a = 0;
		while (a < 160) {
			mem[BIG_FONT_START + a] = BIG_FONT[a];
			a = a + 1;
		}
		a = 0;
		while (a < 16) {
			v[a] = 0u8;
			keys[a] = false;
			stack[a] = 0u16;
			a = a + 1;
		}
		hires = false;
		clearDisplay();
		i = 0u16;
		pc = PROGRAM_START;
		sp = 0;
		dt = 0u8;
		st = 0u8;
		screenDirty = true;
		waitingForFrame = false;
		heldKey = -1;
		halted = false;
		haltReason.clear();
		exited = false;
	}

	#{
	# Copies `rom` to 0x200.
	#}
	fun loadRom(rom: str) -> Result[(), RomTooBig] = {
		let start = PROGRAM_START as i64;
		if (rom.length() > MEMORY_SIZE - start) return Err[RomTooBig](RomTooBig(rom.length(), MEMORY_SIZE - start));
		var k: i64 = 0;
		while (k < rom.length()) {
			mem[start + k] = rom[k] as u8;
			k = k + 1;
		}
		return Ok[()](());
	}

	#{
	# Fetches, decodes and executes one instruction. Does nothing while halted or
	# while waiting for the next frame after a draw.
	#}
	fun step() = {
		if (halted or exited or waitingForFrame) return;
		let op = ((mem[pc as i64] as u16) << 8u16) | (mem[wrapAddr(pc as i64 + 1)] as u16);
		pc = pc + 2u16;
		execute(decode(op));
	}

	#{
	# Runs `instr` against the machine state.
	#}
	fun execute(instr: Instruction) = {
		match (instr) {
			case it: Cls = exec(it);
			case it: Ret = exec(it);
			case it: Jump = exec(it);
			case it: Call = exec(it);
			case it: SkipEqImm = exec(it);
			case it: SkipNeImm = exec(it);
			case it: SkipEqReg = exec(it);
			case it: LoadImm = exec(it);
			case it: AddImm = exec(it);
			case it: Move = exec(it);
			case it: Or = exec(it);
			case it: And = exec(it);
			case it: Xor = exec(it);
			case it: AddReg = exec(it);
			case it: Sub = exec(it);
			case it: ShiftRight = exec(it);
			case it: SubN = exec(it);
			case it: ShiftLeft = exec(it);
			case it: SkipNeReg = exec(it);
			case it: LoadI = exec(it);
			case it: JumpV0 = exec(it);
			case it: Random = exec(it);
			case it: Draw = exec(it);
			case it: SkipKey = exec(it);
			case it: SkipNotKey = exec(it);
			case it: LoadDelay = exec(it);
			case it: WaitKey = exec(it);
			case it: SetDelay = exec(it);
			case it: SetSound = exec(it);
			case it: AddI = exec(it);
			case it: LoadFont = exec(it);
			case it: StoreBcd = exec(it);
			case it: StoreRegs = exec(it);
			case it: LoadRegs = exec(it);
			case it: ScrollDown = exec(it);
			case it: ScrollRight = exec(it);
			case it: ScrollLeft = exec(it);
			case it: Exit = exec(it);
			case it: Lores = exec(it);
			case it: Hires = exec(it);
			case it: LoadBigFont = exec(it);
			case it: SaveFlags = exec(it);
			case it: LoadFlags = exec(it);
			case it: Unknown = exec(it);
		};
	}

	#{
	# 60 Hz tick: decrements timers and ends the display wait.
	#}
	fun tickTimers() = {
		if (dt > 0u8) dt = dt - 1u8;
		if (st > 0u8) st = st - 1u8;
		waitingForFrame = false;
	}

	# Current resolution: 64x32, or 128x64 in SUPER-CHIP hires mode.
	fun width() -> i64 = if hires then HIRES_W else LORES_W;
	fun height() -> i64 = if hires then HIRES_H else LORES_H;

	fun pixel(x: i64, y: i64) -> bool = display[y * width() + x];

	fun clearDisplay() = {
		var a: i64 = 0;
		while (a < DISPLAY_SIZE) {
			display[a] = false;
			a = a + 1;
		}
		screenDirty = true;
	}

	# ---------- helpers ----------
	fun skipIf(cond: bool) = {
		if (cond) pc = pc + 2u16;
	}

	fun halt(reason: String) = {
		halted = true;
		haltReason = move reason;
	}

	# False (and halts) when a SUPER-CHIP instruction runs in CHIP-8 mode.
	fun requireSuperChip(name: str) -> bool = {
		if (not superChip) halt(f"SUPER-CHIP instruction {name} at {hex4((pc - 2u16) as i64)} (run with --schip)");
		return superChip;
	}

	# ---------- instructions ----------
	fun exec(it: Cls) = clearDisplay();

	fun exec(it: Ret) = {
		if (sp == 0) {
			halt("stack underflow (00EE with empty stack)".toString());
		} else {
			sp = sp - 1;
			pc = stack[sp];
		}
	}

	fun exec(it: Jump) = {
		pc = it.nnn;
	}

	fun exec(it: Call) = {
		if (sp == STACK_SIZE) {
			halt("stack overflow (2NNN)".toString());
		} else {
			stack[sp] = pc;
			sp = sp + 1;
			pc = it.nnn;
		}
	}

	fun exec(it: SkipEqImm) = skipIf(v[it.x] == it.nn);
	fun exec(it: SkipNeImm) = skipIf(v[it.x] != it.nn);
	fun exec(it: SkipEqReg) = skipIf(v[it.x] == v[it.y]);
	fun exec(it: SkipNeReg) = skipIf(v[it.x] != v[it.y]);

	fun exec(it: LoadImm) = {
		v[it.x] = it.nn;
	}

	fun exec(it: AddImm) = {
		v[it.x] = v[it.x] + it.nn;
	}

	fun exec(it: Move) = {
		v[it.x] = v[it.y];
	}

	fun exec(it: Or) = {
		v[it.x] = v[it.x] | v[it.y];
		if (not superChip) v[0xF] = 0u8;
	}

	fun exec(it: And) = {
		v[it.x] = v[it.x] & v[it.y];
		if (not superChip) v[0xF] = 0u8;
	}

	fun exec(it: Xor) = {
		v[it.x] = v[it.x] ^ v[it.y];
		if (not superChip) v[0xF] = 0u8;
	}

	fun exec(it: AddReg) = {
		let sum = (v[it.x] as u16) + (v[it.y] as u16);
		v[it.x] = sum as u8;
		v[0xF] = (sum >> 8u16) as u8;
	}

	fun exec(it: Sub) = {
		let noBorrow = v[it.x] >= v[it.y];
		v[it.x] = v[it.x] - v[it.y];
		v[0xF] = noBorrow as u8;
	}

	fun exec(it: SubN) = {
		let noBorrow = v[it.y] >= v[it.x];
		v[it.x] = v[it.y] - v[it.x];
		v[0xF] = noBorrow as u8;
	}

	fun exec(it: ShiftRight) = {
		let value = if superChip then v[it.x] else v[it.y];
		v[it.x] = value >> 1u8;
		v[0xF] = value & 1u8;
	}

	fun exec(it: ShiftLeft) = {
		let value = if superChip then v[it.x] else v[it.y];
		v[it.x] = value << 1u8;
		v[0xF] = value >> 7u8;
	}

	fun exec(it: LoadI) = {
		i = it.nnn;
	}

	fun exec(it: JumpV0) = {
		var offset = v[0];
		if (superChip) offset = v[((it.nnn >> 8u16) & 0xFu16) as i64]; # BXNN
		pc = (it.nnn + (offset as u16)) & 0xFFFu16;
	}

	fun exec(it: Random) = {
		v[it.x] = ((rand() & 0xFF) as u8) & it.nn;
	}

	fun exec(it: Draw) = {
		let w = width();
		let h = height();
		let x0 = (v[it.x] as i64) % w;
		let y0 = (v[it.y] as i64) % h;
		# DXY0 in SUPER-CHIP: 16x16 sprite, two bytes per row.
		let big = superChip and it.n == 0;
		let rows = if big then 16i64 else it.n;
		let cols = if big then 16i64 else 8i64;
		let bytesPerRow = if big then 2i64 else 1i64;
		var collision = 0u8;
		var row: i64 = 0;
		while (row < rows and y0 + row < h) {
			var col: i64 = 0;
			while (col < cols and x0 + col < w) {
				let bits = mem[wrapAddr(i as i64 + row * bytesPerRow + col / 8)];
				if (((bits >> (7 - col % 8) as u8) & 1u8) == 1u8) {
					let idx = (y0 + row) * w + x0 + col;
					if (display[idx]) collision = 1u8;
					display[idx] = not display[idx];
				}
				col = col + 1;
			}
			row = row + 1;
		}
		v[0xF] = collision;
		screenDirty = true;
		if (not superChip) waitingForFrame = true;
	}

	fun exec(it: SkipKey) = skipIf(keys[(v[it.x] & 0xFu8) as i64]);
	fun exec(it: SkipNotKey) = skipIf(not keys[(v[it.x] & 0xFu8) as i64]);

	fun exec(it: LoadDelay) = {
		v[it.x] = dt;
	}

	# Waits for a key to be pressed and then released (COSMAC VIP behaviour).
	fun exec(it: WaitKey) = {
		if (heldKey == -1) {
			var k: i64 = 0;
			while (k < 16 and heldKey == -1) {
				if (keys[k]) heldKey = k;
				k = k + 1;
			}
			pc = pc - 2u16;
		} else if (keys[heldKey]) {
			pc = pc - 2u16;
		} else {
			v[it.x] = heldKey as u8;
			heldKey = -1;
		}
	}

	fun exec(it: SetDelay) = {
		dt = v[it.x];
	}

	fun exec(it: SetSound) = {
		st = v[it.x];
	}

	fun exec(it: AddI) = {
		i = i + (v[it.x] as u16);
	}

	fun exec(it: LoadFont) = {
		i = (FONT_START + ((v[it.x] & 0xFu8) as i64) * 5) as u16;
	}

	fun exec(it: StoreBcd) = {
		let value = v[it.x];
		mem[wrapAddr(i as i64)] = value / 100u8;
		mem[wrapAddr(i as i64 + 1)] = (value / 10u8) % 10u8;
		mem[wrapAddr(i as i64 + 2)] = value % 10u8;
	}

	fun exec(it: StoreRegs) = {
		var r: i64 = 0;
		while (r <= it.x) {
			mem[wrapAddr(i as i64 + r)] = v[r];
			r = r + 1;
		}
		if (not superChip) i = i + (it.x as u16) + 1u16;
	}

	fun exec(it: LoadRegs) = {
		var r: i64 = 0;
		while (r <= it.x) {
			v[r] = mem[wrapAddr(i as i64 + r)];
			r = r + 1;
		}
		if (not superChip) i = i + (it.x as u16) + 1u16;
	}

	# ---------- SUPER-CHIP ----------
	fun exec(it: ScrollDown) = {
		if (requireSuperChip("00CN")) {
			let w = width();
			var y = height() - 1;
			while (y >= 0) {
				var x: i64 = 0;
				while (x < w) {
					display[y * w + x] = y >= it.n and display[(y - it.n) * w + x];
					x = x + 1;
				}
				y = y - 1;
			}
			screenDirty = true;
		}
	}

	fun exec(it: ScrollRight) = {
		if (requireSuperChip("00FB")) {
			let w = width();
			var y: i64 = 0;
			while (y < height()) {
				var x = w - 1;
				while (x >= 0) {
					display[y * w + x] = x >= 4 and display[y * w + x - 4];
					x = x - 1;
				}
				y = y + 1;
			}
			screenDirty = true;
		}
	}

	fun exec(it: ScrollLeft) = {
		if (requireSuperChip("00FC")) {
			let w = width();
			var y: i64 = 0;
			while (y < height()) {
				var x: i64 = 0;
				while (x < w) {
					display[y * w + x] = x < w - 4 and display[y * w + x + 4];
					x = x + 1;
				}
				y = y + 1;
			}
			screenDirty = true;
		}
	}

	fun exec(it: Exit) = {
		if (requireSuperChip("00FD")) exited = true;
	}

	fun exec(it: Lores) = {
		if (requireSuperChip("00FE")) {
			hires = false;
			clearDisplay();
		}
	}

	fun exec(it: Hires) = {
		if (requireSuperChip("00FF")) {
			hires = true;
			clearDisplay();
		}
	}

	fun exec(it: LoadBigFont) = {
		if (requireSuperChip("FX30")) i = (BIG_FONT_START + ((v[it.x] & 0xFu8) as i64) * 10) as u16;
	}

	fun exec(it: SaveFlags) = {
		if (requireSuperChip("FX75")) {
			var r: i64 = 0;
			while (r <= it.x) {
				flags[r] = v[r];
				r = r + 1;
			}
		}
	}

	fun exec(it: LoadFlags) = {
		if (requireSuperChip("FX85")) {
			var r: i64 = 0;
			while (r <= it.x) {
				v[r] = flags[r];
				r = r + 1;
			}
		}
	}

	fun exec(it: Unknown) = {
		halt(f"unknown opcode {hex4(it.op as i64)} at {hex4((pc - 2u16) as i64)}");
	}
}

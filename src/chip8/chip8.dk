#{
# CHIP-8 interpreter core: memory, registers, timers, display and keypad state.
# No I/O here; a frontend calls `step()` / `tickTimers()`, feeds `keys` and redraws
# only when `screenDirty` is set.
#
# Two modes, chosen with `superChip` before `reset()`:
#
# CHIP-8 (default), quirks of the original COSMAC VIP: 8XY1/2/3 reset VF,
# 8XY6/8XYE shift VY, FX55/FX65 advance I, BNNN jumps to NNN + V0, DXYN waits for
# the next frame (display wait). 64x32 display.
#
# SUPER-CHIP, "modern" behaviour (as in Octo): no VF reset, shifts operate on VX,
# FX55/FX65 leave I alone, BXNN jumps to XNN + VX, no display wait. Adds 128x64
# hires mode (00FF/00FE), DXY0 16x16 sprites, scrolling (00CN/00FB/00FC), exit
# (00FD), the large font (FX30) and flag registers (FX75/FX85).
#
# Both modes clip sprites at the screen edge.
#}
import core.builtins.*;
import core.containers.*;
import src.result.Ok;
import src.result.Err;
import src.result.Result;

extern ("C") {
	fundecl rand() -> i32;
}

# ========== CONSTANTS ===========
const LORES_W: i64 = 64;
const LORES_H: i64 = 32;
const HIRES_W: i64 = 128;
const HIRES_H: i64 = 64;
const DISPLAY_SIZE: i64 = 128 * 64;
const MEMORY_SIZE: i64 = 4096;
const PROGRAM_START: u16 = 0x200u16;
const FONT_START: i64 = 0x50;
const BIG_FONT_START: i64 = 0xA0; # right after the 80-byte small font
const STACK_SIZE: i64 = 16;


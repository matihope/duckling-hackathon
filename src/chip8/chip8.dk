#{
# CHIP-8 interpreter core: memory, registers, timers, display and keypad state.
# No I/O here; a frontend calls `run()` / `tickTimers()`, feeds `keys` and
# redraws only when `display.dirty` is set.
#
# The instruction set lives in `isa` (one table, compiled into the instruction
# classes, `decode` and the dispatch below); the quirks of each machine in
# `platform`. Both platforms clip sprites at the screen edge.
#}
import core.builtins.*;
import core.containers.*;
import src.result.Ok;
import src.result.Err;
import src.result.Result;
import isa.*;
import isa.instructions.*;
import platform.*;
import src.display.Display;

extern ("C") {
	fundecl rand() -> i32;
}

# ========== CONSTANTS ===========
const MEMORY_SIZE: i64 = 4096;
const PROGRAM_START: u16 = 0x200u16;
const FONT_START: i64 = 0x50;
const BIG_FONT_START: i64 = 0xA0; # right after the 80-byte small font
const STACK_SIZE: i64 = 16;

# Font glyphs as hex, one byte per pixel row. (`var`: a const array hangs duckc.)
# 0-F, 4x5 pixels.
var FONT: str[16] = [
	"F0909090F0",
	"2060202070",
	"F010F080F0",
	"F010F010F0",
	"9090F01010",
	"F080F010F0",
	"F080F090F0",
	"F010204040",
	"F090F090F0",
	"F090F010F0",
	"F090F09090",
	"E090E090E0",
	"F0808080F0",
	"E0909090E0",
	"F080F080F0",
	"F080F08080"
];

# SUPER-CHIP large font (FX30): 0-F, 8x10 pixels, as in Octo.
var BIG_FONT: str[16] = [
	"FFFFC3C3C3C3C3C3FFFF",
	"1878781818181818FFFF",
	"FFFF0303FFFFC0C0FFFF",
	"FFFF0303FFFF0303FFFF",
	"C3C3C3C3FFFF03030303",
	"FFFFC0C0FFFF0303FFFF",
	"FFFFC0C0FFFFC3C3FFFF",
	"FFFF0303060C18181818",
	"FFFFC3C3FFFFC3C3FFFF",
	"FFFFC3C3FFFF0303FFFF",
	"7EFFC3C3C3FFFFC3C3C3",
	"FCFCC3C3FCFCC3C3FCFC",
	"3CFFC3C0C0C0C0C3FF3C",
	"FCFEC3C3C3C3C3C3FEFC",
	"FFFFC0C0FFFFC0C0FFFF",
	"FFFFC0C0FFFFC0C0C0C0"
];

# ========== STATUS ===========
class Running {}

#{
# Stopped on an instruction it can't run.
#}
class Halted {
	reason: String;
}

#{
# SUPER-CHIP 00FD ran.
#}
class Exited {}

const Status = Running | Halted | Exited;

#{
# The ROM doesn't fit in memory above 0x200.
#}
class RomTooBig {
	size: i64;
	max: i64;
}

# `0x`-prefixed, zero-padded 4-digit uppercase hex.
fun hex4(v: i64) -> String = {
	let digits = "0123456789ABCDEF";
	var out = "0x".toString();
	var shift: i64 = 12;
	while (shift >= 0) {
		out.append(digits[(v >> shift) & 15]);
		shift = shift - 4;
	}
	return out;
}

fun hexNibble(c: char) -> u8 = if '0' <= c <= '9' then (c - '0') as u8 else (c - 'A') as u8 + 10u8;

# Wraps an address into the 4 KiB memory.
fun wrapAddr(a: i64) -> i64 = a & (MEMORY_SIZE - 1);

# ========== MACHINE ===========
class Chip8 {
	platform: Platform = cosmacVip();
	mem: u8[MEMORY_SIZE];
	v: u8[16];
	i: u16 = 0u16;
	pc: u16 = PROGRAM_START;
	stack: u16[STACK_SIZE];
	sp: i64 = 0;
	dt: u8 = 0u8; # delay timer
	st: u8 = 0u8; # sound timer
	display: Display; # also holds the hires flag and the dirty flag for the frontend
	# `u8` (0 or 1), not `bool`: a `bool[N]` field breaks the class layout in duckc
	# (BUGS.md 32). Written through `setKey()`.
	keys: u8[16]; # 1 while held; set by the frontend
	waitingForFrame: bool = false; # DXYN ran this frame (display wait quirk)
	heldKey: ?i64 = none; # FX0A: key seen pressed, waiting for its release
	status: Status = Running();
	flags: u8[16]; # SUPER-CHIP FX75/FX85 registers

	#{
	# Copies `rom` to 0x200.
	#}
	fun loadRom(rom: str) -> Result[(), RomTooBig] = {
		let start = PROGRAM_START as i64;
		if (rom.length() > MEMORY_SIZE - start) return Err[RomTooBig](RomTooBig(rom.length(), MEMORY_SIZE - start));
		var k: i64 = 0;
		while (k < rom.length()) {
			mem[start + k] = rom[k] as u8;
			k = k + 1;
		}
		return Ok[()](());
	}

	fun running() -> bool = match (&status) {
		case _: ref Running = true;
		case _ = false;
	};

	#{
	# Fetches, decodes and executes one instruction. Does nothing once stopped or
	# while waiting for the next frame after a draw.
	#}
	fun step() = {
		if (not running() or waitingForFrame) return;
		let op = ((mem[pc as i64] as u16) << 8u16) | (mem[wrapAddr(pc as i64 + 1)] as u16);
		pc = pc + 2u16;
		execute(decode(op));
	}

	fun run(cycles: i64) = {
		var n: i64 = 0;
		while (n < cycles) {
			step();
			n = n + 1;
		}
	}

	#{
	# Runs `instr` against the machine state.
	#}
	fun execute(instr: Instruction) = {
		expand dispatch("instr");
	}

	#{
	# 60 Hz tick: decrements timers and ends the display wait.
	#}
	fun tickTimers() = {
		if (dt > 0u8) dt = dt - 1u8;
		if (st > 0u8) st = st - 1u8;
		waitingForFrame = false;
	}

	#{
	# One 60 Hz frame: the platform's instructions per frame, then the timers.
	#}
	fun runFrame() = {
		run(platform.cyclesPerFrame);
		tickTimers();
	}

	# Current resolution: 64x32, or 128x64 in SUPER-CHIP hires mode.
	fun width() -> i64 = display.width();
	fun height() -> i64 = display.height();

	fun pixel(x: i64, y: i64) -> bool = display.get(x, y);

	#{
	# Marks hex key `k` (0..15) as held or released.
	#}
	fun setKey(k: i64, down: bool) = {
		keys[k] = down as u8;
	}

	# ---------- helpers ----------
	#{
	# Writes the bytes of the hex string `glyph` to memory from `at`.
	#}
	fun writeHex(at: i64, glyph: str) = {
		var k: i64 = 0;
		while (k + 1 < glyph.length()) {
			mem[at + k / 2] = hexNibble(glyph[k]) * 16u8 + hexNibble(glyph[k + 1]);
			k = k + 2;
		}
	}

	fun loadFonts() = {
		var g: i64 = 0;
		while (g < 16) {
			writeHex(FONT_START + g * 5, FONT[g]);
			writeHex(BIG_FONT_START + g * 10, BIG_FONT[g]);
			g = g + 1;
		}
	}

	fun skipIf(cond: bool) = {
		if (cond) pc = pc + 2u16;
	}

	fun halt(reason: String) = {
		status = Halted(move reason);
	}

	fun here() -> String = hex4((pc - 2u16) as i64);

	# False (and halts) when a SUPER-CHIP instruction runs on a CHIP-8 platform.
	fun requireSuperChip(opcode: str) -> bool = {
		if (not platform.superChipOps) halt(f"SUPER-CHIP instruction {opcode} at {here()} (run without --chip8)");
		return platform.superChipOps;
	}

	fun pressedKey() -> ?i64 = {
		var k: i64 = 0;
		while (k < 16) {
			if (keys[k] != 0u8) return k;
			k = k + 1;
		}
		return none;
	}

	# ---------- instructions ----------
	fun exec(it: Cls) = display.clear();

	fun exec(it: Ret) = {
		if (sp == 0) {
			halt("stack underflow (00EE with empty stack)".toString());
		} else {
			sp = sp - 1;
			pc = stack[sp];
		}
	}

	fun exec(it: Jump) = {
		pc = it.nnn;
	}

	fun exec(it: Call) = {
		if (sp == STACK_SIZE) {
			halt("stack overflow (2NNN)".toString());
		} else {
			stack[sp] = pc;
			sp = sp + 1;
			pc = it.nnn;
		}
	}

	fun exec(it: SkipEqImm) = skipIf(v[it.x] == it.nn);
	fun exec(it: SkipNeImm) = skipIf(v[it.x] != it.nn);
	fun exec(it: SkipEqReg) = skipIf(v[it.x] == v[it.y]);
	fun exec(it: SkipNeReg) = skipIf(v[it.x] != v[it.y]);

	fun exec(it: LoadImm) = {
		v[it.x] = it.nn;
	}

	fun exec(it: AddImm) = {
		v[it.x] = v[it.x] + it.nn;
	}

	fun exec(it: Move) = {
		v[it.x] = v[it.y];
	}

	fun exec(it: Or) = {
		v[it.x] = v[it.x] | v[it.y];
		if (platform.vfReset) v[0xF] = 0u8;
	}

	fun exec(it: And) = {
		v[it.x] = v[it.x] & v[it.y];
		if (platform.vfReset) v[0xF] = 0u8;
	}

	fun exec(it: Xor) = {
		v[it.x] = v[it.x] ^ v[it.y];
		if (platform.vfReset) v[0xF] = 0u8;
	}

	fun exec(it: AddReg) = {
		let sum = (v[it.x] as u16) + (v[it.y] as u16);
		v[it.x] = sum as u8;
		v[0xF] = (sum >> 8u16) as u8;
	}

	fun exec(it: Sub) = {
		let noBorrow = v[it.x] >= v[it.y];
		v[it.x] = v[it.x] - v[it.y];
		v[0xF] = noBorrow as u8;
	}

	fun exec(it: SubN) = {
		let noBorrow = v[it.y] >= v[it.x];
		v[it.x] = v[it.y] - v[it.x];
		v[0xF] = noBorrow as u8;
	}

	fun exec(it: ShiftRight) = {
		let value = if platform.shiftVy then v[it.y] else v[it.x];
		v[it.x] = value >> 1u8;
		v[0xF] = value & 1u8;
	}

	fun exec(it: ShiftLeft) = {
		let value = if platform.shiftVy then v[it.y] else v[it.x];
		v[it.x] = value << 1u8;
		v[0xF] = value >> 7u8;
	}

	fun exec(it: LoadI) = {
		i = it.nnn;
	}

	# BNNN: NNN + V0, or BXNN: XNN + VX with the jumpVx quirk.
	fun exec(it: JumpOffset) = {
		let reg = if platform.jumpVx then ((it.nnn >> 8u16) & 0xFu16) as i64 else 0i64;
		pc = (it.nnn + (v[reg] as u16)) & 0xFFFu16;
	}

	fun exec(it: Random) = {
		v[it.x] = ((rand() & 0xFF) as u8) & it.nn;
	}

	fun exec(it: Draw) = {
		let w = width();
		let h = height();
		let x0 = (v[it.x] as i64) % w;
		let y0 = (v[it.y] as i64) % h;
		# DXY0 in SUPER-CHIP: 16x16 sprite, two bytes per row.
		let big = platform.superChipOps and it.n == 0;
		let rows = if big then 16i64 else it.n;
		let cols = if big then 16i64 else 8i64;
		let bytesPerRow = if big then 2i64 else 1i64;
		var collision = 0u8;
		var row: i64 = 0;
		while (row < rows and y0 + row < h) {
			var col: i64 = 0;
			while (col < cols and x0 + col < w) {
				let bits = mem[wrapAddr(i as i64 + row * bytesPerRow + col / 8)];
				if (((bits >> (7 - col % 8) as u8) & 1u8) == 1u8) {
					if (display.flip(x0 + col, y0 + row)) collision = 1u8;
				}
				col = col + 1;
			}
			row = row + 1;
		}
		v[0xF] = collision;
		display.dirty = true; # even a sprite with no pixels set counts as a draw
		waitingForFrame = platform.displayWait;
	}

	fun exec(it: SkipKey) = skipIf(keys[(v[it.x] & 0xFu8) as i64] != 0u8);
	fun exec(it: SkipNotKey) = skipIf(keys[(v[it.x] & 0xFu8) as i64] == 0u8);

	fun exec(it: LoadDelay) = {
		v[it.x] = dt;
	}

	# Waits for a key to be pressed and then released (COSMAC VIP behaviour).
	fun exec(it: WaitKey) = {
		if (heldKey.isEmpty()) {
			heldKey = pressedKey();
			pc = pc - 2u16;
		} else if (keys[heldKey.value()] != 0u8) {
			pc = pc - 2u16;
		} else {
			v[it.x] = heldKey.value() as u8;
			heldKey = none;
		}
	}

	fun exec(it: SetDelay) = {
		dt = v[it.x];
	}

	fun exec(it: SetSound) = {
		st = v[it.x];
	}

	fun exec(it: AddI) = {
		i = i + (v[it.x] as u16);
	}

	fun exec(it: LoadFont) = {
		i = (FONT_START + ((v[it.x] & 0xFu8) as i64) * 5) as u16;
	}

	fun exec(it: StoreBcd) = {
		let value = v[it.x];
		mem[wrapAddr(i as i64)] = value / 100u8;
		mem[wrapAddr(i as i64 + 1)] = (value / 10u8) % 10u8;
		mem[wrapAddr(i as i64 + 2)] = value % 10u8;
	}

	fun exec(it: StoreRegs) = {
		var r: i64 = 0;
		while (r <= it.x) {
			mem[wrapAddr(i as i64 + r)] = v[r];
			r = r + 1;
		}
		if (platform.memIncrement) i = i + (it.x as u16) + 1u16;
	}

	fun exec(it: LoadRegs) = {
		var r: i64 = 0;
		while (r <= it.x) {
			v[r] = mem[wrapAddr(i as i64 + r)];
			r = r + 1;
		}
		if (platform.memIncrement) i = i + (it.x as u16) + 1u16;
	}

	# ---------- SUPER-CHIP (dispatch checks the platform first) ----------
	fun exec(it: ScrollDown) = display.shift(0, it.n);
	fun exec(it: ScrollRight) = display.shift(4, 0);
	fun exec(it: ScrollLeft) = display.shift(-4, 0);

	fun exec(it: Exit) = {
		status = Exited();
	}

	fun exec(it: Lores) = display.setHires(false);
	fun exec(it: Hires) = display.setHires(true);

	fun exec(it: LoadBigFont) = {
		i = (BIG_FONT_START + ((v[it.x] & 0xFu8) as i64) * 10) as u16;
	}

	fun exec(it: SaveFlags) = {
		var r: i64 = 0;
		while (r <= it.x) {
			flags[r] = v[r];
			r = r + 1;
		}
	}

	fun exec(it: LoadFlags) = {
		var r: i64 = 0;
		while (r <= it.x) {
			v[r] = flags[r];
			r = r + 1;
		}
	}

	fun exec(it: Unknown) = {
		halt(f"unknown opcode {hex4(it.op as i64)} at {here()}");
	}
}

#{
# A fresh machine for `platform` with the fonts loaded, ready for `loadRom`.
#}
fun newChip8(platform: Platform) -> Chip8 = {
	var c: Chip8;
	c.platform = platform;
	c.loadFonts();
	return c;
}

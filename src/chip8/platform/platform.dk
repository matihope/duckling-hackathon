#{
# Which machine the interpreter behaves like: the instruction set it accepts,
# the quirks the original hardware had, and how fast it runs.
#}
import core.builtins.*;

class Platform {
	name: str;
	superChipOps: bool; # SUPER-CHIP instructions (hires, scrolling, big font, ...)
	vfReset: bool; # 8XY1/8XY2/8XY3 clear VF
	shiftVy: bool; # 8XY6/8XYE shift VY into VX (otherwise VX in place)
	memIncrement: bool; # FX55/FX65 advance I past the registers
	jumpVx: bool; # BXNN jumps to XNN + VX (otherwise BNNN to NNN + V0)
	displayWait: bool; # DXYN waits for the next frame
	cyclesPerFrame: i64; # instructions per 60 Hz frame
}

#{
# The original COSMAC VIP interpreter.
#}
fun cosmacVip() -> Platform = Platform(
	name = "CHIP-8",
	superChipOps = false,
	vfReset = true,
	shiftVy = true,
	memIncrement = true,
	jumpVx = false,
	displayWait = true,
	cyclesPerFrame = 11
);

#{
# SUPER-CHIP with the "modern" quirks Octo uses.
#}
fun superChip() -> Platform = Platform(
	name = "SUPER-CHIP",
	superChipOps = true,
	vfReset = false,
	shiftVy = false,
	memIncrement = false,
	jumpVx = true,
	displayWait = false,
	cyclesPerFrame = 30
);

#{
# Compile-time CHIP-8 assembler for inline programs in tests:
#
#     var c: Chip8;
#     c.reset();
#     expand ch8("c", "LD V0, 0xFF; ADD V0, 1; DRW V0, V1, 5");
#
# expands to a block of `c.mem[0x200 + k] = <byte>u8;` assignments.
#
# Syntax (Cowgod mnemonics, case-insensitive): instructions separated by `;` or
# newlines, operands by spaces or commas. Numbers: decimal, `0x..` or `#..` hex.
# A bare 4-digit hex token (`6005`) is a raw opcode; `DB b1 [b2 [b3]]` emits raw bytes.
# A bad instruction expands to a call of the undefined `ch8_asm_error_in_instruction_<n>`
# (n counts instructions from 1), so the
# build fails pointing at the `expand`.
#}
import core.builtins.*;
import core.containers.*;

# ========== LEXING ===========

fun isSeparator(c: char) -> bool = c == ' ' or c == '\t' or c == ',';

fun isLineEnd(c: char) -> bool = c == ';' or c == '\n';

fun upper(c: char) -> char = {
	if ('a' <= c <= 'z') return 'A' + (c - 'a');
	return c;
}

fun hexDigit(c: char) -> i64 = {
	if ('0' <= c <= '9') return (c - '0') as i64;
	if ('A' <= c <= 'F') return (c - 'A') as i64 + 10;
	return -1;
}

fun isLit(t: ref String, lit: str) -> bool = {
	if (t.length() != lit.length()) return false;
	var k: i64 = 0;
	var same = true;
	while (same and k < lit.length()) {
		same = t.at(k) == lit[k];
		k = k + 1;
	}
	return same;
}

#{
# `V0`..`VF` -> 0..15, anything else -> -1.
#}
fun reg(t: ref String) -> i64 = {
	if (t.length() != 2 or t.at(0) != 'V') return -1;
	return hexDigit(t.at(1));
}

#{
# Decimal, `0x..` or `#..` hex -> value, invalid -> -1.
#}
fun num(t: ref String) -> i64 = {
	var k: i64 = 0;
	var base: i64 = 10;
	if (t.length() > 2 and t.at(0) == '0' and t.at(1) == 'X') {
		base = 16;
		k = 2;
	} else if (t.length() > 1 and t.at(0) == '#') {
		base = 16;
		k = 1;
	}
	if (k >= t.length()) return -1;
	var value: i64 = 0;
	var ok = true;
	while (ok and k < t.length()) {
		let d = hexDigit(t.at(k));
		ok = d >= 0 and d < base;
		value = value * base + d;
		k = k + 1;
	}
	if (not ok) return -1;
	return value;
}

#{
# Raw opcode: exactly 4 hex digits -> value, else -1.
#}
fun rawWord(t: ref String) -> i64 = {
	if (t.length() != 4) return -1;
	var value: i64 = 0;
	var k: i64 = 0;
	while (k < 4) {
		let d = hexDigit(t.at(k));
		if (d < 0) return -1;
		value = value * 16 + d;
		k = k + 1;
	}
	return value;
}

# ========== ENCODING ===========

fun xy(base: i64, x: i64, y: i64) -> i64 = {
	if (x < 0 or y < 0) return -1;
	return base | (x << 8) | (y << 4);
}

fun xkk(base: i64, x: i64, kk: i64) -> i64 = {
	if (x < 0 or kk < 0 or kk > 0xFF) return -1;
	return base | (x << 8) | kk;
}

fun nnn(base: i64, addr: i64) -> i64 = {
	if (addr < 0 or addr > 0xFFF) return -1;
	return base | addr;
}

fun xOnly(base: i64, x: i64) -> i64 = {
	if (x < 0) return -1;
	return base | (x << 8);
}

#{
# One instruction -> 16-bit opcode, or -1 when it isn't valid.
#}
fun encode(mn: ref String, a: ref String, b: ref String, c: ref String, argc: i64) -> i64 = {
	let ra = reg(a);
	let rb = reg(b);
	if (argc == 0) {
		if (isLit(mn, "CLS")) return 0x00E0;
		if (isLit(mn, "RET")) return 0x00EE;
		return rawWord(mn);
	}
	if (argc == 1) {
		if (isLit(mn, "JP")) return nnn(0x1000, num(a));
		if (isLit(mn, "CALL")) return nnn(0x2000, num(a));
		if (isLit(mn, "SHR")) return xy(0x8006, ra, ra);
		if (isLit(mn, "SHL")) return xy(0x800E, ra, ra);
		if (isLit(mn, "SKP")) return xOnly(0xE09E, ra);
		if (isLit(mn, "SKNP")) return xOnly(0xE0A1, ra);
		return -1;
	}
	if (argc == 3) {
		if (isLit(mn, "DRW")) {
			let n = num(c);
			if (n < 0 or n > 15) return -1;
			return xy(0xD000 | n, ra, rb);
		}
		return -1;
	}
	# argc == 2
	if (isLit(mn, "JP") and isLit(a, "V0")) return nnn(0xB000, num(b));
	if (isLit(mn, "SE")) {
		if (rb >= 0) return xy(0x5000, ra, rb);
		return xkk(0x3000, ra, num(b));
	}
	if (isLit(mn, "SNE")) {
		if (rb >= 0) return xy(0x9000, ra, rb);
		return xkk(0x4000, ra, num(b));
	}
	if (isLit(mn, "ADD")) {
		if (isLit(a, "I")) return xOnly(0xF01E, rb);
		if (rb >= 0) return xy(0x8004, ra, rb);
		return xkk(0x7000, ra, num(b));
	}
	if (isLit(mn, "OR")) return xy(0x8001, ra, rb);
	if (isLit(mn, "AND")) return xy(0x8002, ra, rb);
	if (isLit(mn, "XOR")) return xy(0x8003, ra, rb);
	if (isLit(mn, "SUB")) return xy(0x8005, ra, rb);
	if (isLit(mn, "SHR")) return xy(0x8006, ra, rb);
	if (isLit(mn, "SUBN")) return xy(0x8007, ra, rb);
	if (isLit(mn, "SHL")) return xy(0x800E, ra, rb);
	if (isLit(mn, "RND")) return xkk(0xC000, ra, num(b));
	if (isLit(mn, "LD")) {
		if (isLit(a, "I")) return nnn(0xA000, num(b));
		if (isLit(a, "DT")) return xOnly(0xF015, rb);
		if (isLit(a, "ST")) return xOnly(0xF018, rb);
		if (isLit(a, "F")) return xOnly(0xF029, rb);
		if (isLit(a, "B")) return xOnly(0xF033, rb);
		if (isLit(a, "[I]")) return xOnly(0xF055, rb);
		if (isLit(b, "DT")) return xOnly(0xF007, ra);
		if (isLit(b, "K")) return xOnly(0xF00A, ra);
		if (isLit(b, "[I]")) return xOnly(0xF065, ra);
		if (rb >= 0) return xy(0x8000, ra, rb);
		return xkk(0x6000, ra, num(b));
	}
	return -1;
}

# ========== CODE GENERATION ===========

fun emitByte(out: ref String, target: str, addr: i64, value: i64) = {
	out.append(target);
	out.append(".mem[");
	out.append(addr.toString());
	out.append("] = ");
	out.append(value.toString());
	out.append("u8;\n");
}

#{
# Duckling source (one `{ ... }` block) storing the assembled `src` into
# `<target>.mem` from 0x200. Use as `expand ch8("chip", "...")`.
#}
fun ch8(target: str, src: str) -> String = {
	var out = "{\n".toString();
	var addr: i64 = 0x200;
	var line: i64 = 1; # 1-based index of the current instruction
	var k: i64 = 0;
	var failed = false;
	while (not failed and k <= src.length()) {
		# One instruction: up to 4 tokens until `;`, newline or end.
		var mn: String;
		var a: String;
		var b: String;
		var c: String;
		var argc: i64 = -1;
		while (k < src.length() and not isLineEnd(src[k])) {
			while (k < src.length() and isSeparator(src[k])) k = k + 1;
			if (k < src.length() and not isLineEnd(src[k])) {
				argc = argc + 1;
				while (k < src.length() and not isSeparator(src[k]) and not isLineEnd(src[k])) {
					let ch = upper(src[k]);
					if (argc == 0) mn.append(ch);
					if (argc == 1) a.append(ch);
					if (argc == 2) b.append(ch);
					if (argc == 3) c.append(ch);
					k = k + 1;
				}
			}
		}
		k = k + 1;

		if (argc >= 0) {
			if (isLit(&mn, "DB")) {
				var bytes: i64 = 0;
				if (argc >= 1 and num(&a) >= 0 and num(&a) <= 0xFF) {
					emitByte(&out, target, addr, num(&a));
					bytes = bytes + 1;
				}
				if (argc >= 2 and num(&b) >= 0 and num(&b) <= 0xFF) {
					emitByte(&out, target, addr + 1, num(&b));
					bytes = bytes + 1;
				}
				if (argc >= 3 and num(&c) >= 0 and num(&c) <= 0xFF) {
					emitByte(&out, target, addr + 2, num(&c));
					bytes = bytes + 1;
				}
				failed = bytes != argc;
				addr = addr + bytes;
			} else {
				let op = encode(&mn, &a, &b, &c, argc);
				if (op < 0) {
					failed = true;
				} else {
					emitByte(&out, target, addr, op >> 8);
					emitByte(&out, target, addr + 1, op & 0xFF);
					addr = addr + 2;
				}
			}
		}
		if (not failed and argc >= 0) line = line + 1;
	}
	if (failed) {
		out.append("ch8_asm_error_in_instruction_");
		out.append(line.toString());
		out.append("();\n");
	}
	out.append("}");
	return out;
}

#{
# Runs a `Chip8` in the terminal: 60 Hz frames, keypad from stdin, redraw only
# when the machine wrote to the screen, terminal bell for the sound timer.
#}
import core.builtins.*;
import core.containers.*;
import src.chip8.Chip8;
import src.chip8.Halted;
import src.tui.*;
import src.tui.terminal.*;
import src.tui.render.*;
import src.errors.*;

# ========== TIMING ===========
const FRAME_NS: i64 = 16666667; # 60 Hz

# Terminals report key presses but not releases, so a key counts as held
# for this long after its last byte (auto-repeat keeps refreshing it).
const KEY_HOLD_NS: i64 = 300000000;

# ========== KEYPAD ===========
# Character at index k is the keyboard key for CHIP-8 key k:
#   1 2 3 C      1 2 3 4
#   4 5 6 D  <-  q w e r
#   7 8 9 E      a s d f
#   A 0 B F      z x c v
const KEY_CHARS: str = "x123qweasdzc4rfv";
const CTRL_C: u8 = 3u8;
const ESC_BYTE: u8 = 27u8;
const STATUS_ROWS: i64 = 1;

fun nowNs() -> i64 = {
	var ts: Timespec;
	clock_gettime(CLOCK_MONOTONIC, &ts as cptr mut Timespec);
	return ts.tv_sec * 1000000000 + ts.tv_nsec;
}

fun sleepNs(ns: i64) = {
	if (ns > 0) {
		var req = Timespec(ns / 1000000000, ns % 1000000000);
		var rem: Timespec;
		nanosleep(&req as cptr Timespec, &rem as cptr mut Timespec);
	}
}

#{
# CHIP-8 key for keyboard byte `b`, if it is one.
#}
fun keyFor(b: u8) -> ?i64 = {
	var c = b as char;
	if ('A' <= c <= 'Z') c = 'a' + (c - 'A');
	var k: i64 = 0;
	while (k < 16) {
		if (KEY_CHARS[k] == c) return k;
		k = k + 1;
	}
	return none;
}

class Keypad {
	heldUntil: i64[16]; # ns timestamp until which each key counts as pressed
	quit: bool = false;

	#{
	# Drains stdin: refreshes pressed keys, notices Ctrl-C and a lone Esc.
	# Escape sequences (arrows etc.) are dropped.
	#}
	fun poll(term: ref Terminal, now: i64) = {
		var next = term.readByte();
		while (not next.isEmpty()) {
			let b = next.value();
			next = term.readByte();
			if (b == CTRL_C) quit = true;
			if (b == ESC_BYTE) {
				if (next.isEmpty()) quit = true;
				while (not next.isEmpty()) next = term.readByte();
			}
			let k = keyFor(b);
			if (k.nonEmpty()) heldUntil[k.value()] = now + KEY_HOLD_NS;
		}
	}

	fun apply(chip: ref Chip8, now: i64) = {
		var k: i64 = 0;
		while (k < 16) {
			chip.setKey(k, now < heldUntil[k]);
			k = k + 1;
		}
	}
}

#{
# Failed with `Halted` when the machine halted, succeeded otherwise.
#}
fun stopResult(chip: ref Chip8) -> AppResult = match (&chip.status) {
	case h: ref Halted = failed(Halted(copy h.reason));
	case _ = succeeded();
};

# ========== TERMINAL RUN ===========

fun drawStatus(term: ref Terminal, chip: ref Chip8, title: str) = {
	var out = "".toString();
	appendMoveTo(&out, 1, 1);
	out.append(title);
	out.append("  [");
	out.append(chip.platform.name);
	out.append("]");
	out.append("  |  keys: 1234 qwer asdf zxcv  |  Ctrl-C / Esc: quit");
	term.writeAll(out.asSlice());
}

#{
# Where the frame is drawn. Re-placed whenever the program switches resolution,
# so a 64x32 program fits a small terminal and the frame grows on `hires`.
#}
class Screen {
	at: Placement;
	placedWidth: i64 = 0; # width `at` was computed for; 0 = not placed yet
	small: TooSmall; # why the last `fit` failed

	fun accept(p: Placement) -> bool = {
		at = p;
		return true;
	}

	fun reject(s: TooSmall) -> bool = {
		small = s;
		return false;
	}

	#{
	# Clears the terminal and places the frame for `chip`'s current resolution.
	# False when the terminal is too small for it.
	#}
	mut fun fit(term: ref Terminal, chip: ref Chip8, title: str, size: Winsize) -> bool = {
		let ok = match (placeCentered(size, STATUS_ROWS, chip.width(), chip.height())) {
			case p: Placement = accept(p);
			case s: TooSmall = reject(s);
		};
		if (ok) {
			placedWidth = chip.width();
			var out = "".toString();
			appendCsi(&out, "2J");
			term.writeAll(out.asSlice());
			drawStatus(term, chip, title);
			chip.display.dirty = true;
		}
		return ok;
	}
}

fun runFrames(term: ref Terminal, chip: ref Chip8, title: str, size: Winsize) -> AppResult = {
	var keypad: Keypad;
	var screen: Screen;
	var beeping = false;
	let bel = 7u8 as char;

	var deadline = nowNs();
	while (not keypad.quit and chip.running()) {
		if (chip.width() != screen.placedWidth and not screen.fit(term, chip, title, size)) return failed(screen.small);

		let now = nowNs();
		keypad.poll(term, now);
		keypad.apply(chip, now);
		chip.runFrame();

		if (chip.display.dirty) {
			let frame = renderFrame(&chip.display, screen.at);
			term.writeAll(frame.asSlice());
			chip.display.dirty = false;
		}

		let sound = chip.st > 0u8;
		if (sound and not beeping) {
			var out = "".toString();
			out.append(bel);
			term.writeAll(out.asSlice());
		}
		beeping = sound;

		deadline = deadline + FRAME_NS;
		sleepNs(deadline - nowNs());
	}
	return stopResult(chip);
}

fun runInTerminal(term: ref Terminal, chip: ref Chip8, title: str) -> AppResult = {
	return match (term.size()) {
		case size: Winsize = runFrames(term, chip, title, size);
		case err: TerminalError = failed(err);
	};
}

#{
# Runs `chip` interactively until the user quits or the machine halts.
# The terminal is restored (by `Terminal`'s destructor) before this returns.
#}
fun runInteractive(chip: ref Chip8, title: str) -> AppResult = {
	return match (Terminal.open()) {
		case term: Terminal = runInTerminal(&term, chip, title);
		case err: TerminalError = failed(err);
	};
}

# ========== HEADLESS ===========

#{
# Runs `frames` frames with no input and prints the screen at its current
# resolution as `#`/`.` rows.
#}
fun runHeadless(chip: ref Chip8, frames: i64) -> AppResult = {
	var f: i64 = 0;
	while (f < frames and chip.running()) {
		chip.runFrame();
		f = f + 1;
	}
	var out = "".toString();
	var y: i64 = 0;
	while (y < chip.height()) {
		var x: i64 = 0;
		while (x < chip.width()) {
			if (chip.pixel(x, y)) {
				out.append('#');
			} else {
				out.append('.');
			}
			x = x + 1;
		}
		out.append('\n');
		y = y + 1;
	}
	print(&out);
	return stopResult(chip);
}

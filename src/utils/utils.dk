import core.builtins as builtins;
import core.containers as containers;
import src.strings.*;

extern ("C") {
	fundecl fopen(path: cptr char, mode: cptr char) -> cptr u8;
	fundecl fread(buf: cptr u8, size: u64, n: u64, f: cptr u8) -> u64;
	fundecl fclose(f: cptr u8) -> i32;
}

const CHUNK: i64 = 4096; # same as page size

#{
    Opens `path` with the given C `mode`. `path` doesn't have to be NUL-terminated.
#}
fun openFile(path: str, mode: str) -> cptr u8 = {
	var c_path: String;
	c_path.append(path);
	c_path.append('\0');
	var c_mode: String;
	c_mode.append(mode);
	c_mode.append('\0');
	return fopen(c_path.pointer as cptr char, c_mode.pointer as cptr char);
}

# Whole contents of the file, or none when it can't be opened.
fun readFile(path: str) -> ?String = {
	let f = openFile(path, "r");
	if (f as u64 == 0u64) return none;

	var content: String;
	let chunk = allocation[char].many_alloc(CHUNK);
	var n = fread(chunk as cptr u8, 1u64, CHUNK as u64, f) as i64;
	while (n > 0i64) {
		var i = 0i64;
		while (i < n) {
			content.append(chunk[i]);
			i = i + 1i64;
		}
		n = fread(chunk as cptr u8, 1u64, CHUNK as u64, f) as i64;
	}
	allocation[char].many_free(chunk);
	fclose(f);
	return content;
}

#{
# The command line of this process (argv[0] first), or none when it can't be read.
# @note Linux only.
#}
fun processCmdline() -> ?List[String] = {
	var content = readFile("/proc/self/cmdline");
	if (content.isEmpty()) return none;
	return splitNul(content.value());
}

#{
# The program's arguments, argv[0] first; none when they can't be read.
#
# On the native backend this is the process's own command line. On the DVM the
# process is the `VM` binary, so see `argsFromVmCmdline`.
#}
@backend_dependent
fundecl readCmdline() -> ?List[String];

@native_only_impl
fun readCmdline() -> ?List[String] = processCmdline();

@dvm_only_impl
fun readCmdline() -> ?List[String] = {
	var vm = processCmdline();
	if (vm.isEmpty()) return none;
	return argsFromVmCmdline(vm.value());
}

#{
# The program's arguments out of the VM's command line,
# `VM [options] run [options] [-c a,b,c] program.dbc`: the .dbc path becomes
# argv[0], followed by the `-c` / `--args` list. The VM splits that list on
# commas, so a single argument can't contain one.
#}
fun argsFromVmCmdline(vm: ref List[String]) -> List[String] = {
	var args: List[String];
	if (vm.length() == 0) return args;
	args.push(vm.at(vm.length() - 1).toString());
	var k: i64 = 0;
	while (k + 1 < vm.length()) {
		let option = vm.at(k).asSlice();
		if (strEq(option, "-c") or strEq(option, "--args")) {
			var given = splitOn(vm.at(k + 1).asSlice(), ',');
			var j: i64 = 0;
			while (j < given.length()) {
				args.push(given.at(j).toString());
				j = j + 1;
			}
		}
		k = k + 1;
	}
	return args;
}
